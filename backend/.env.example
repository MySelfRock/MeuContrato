# Database
DATABASE_URL="postgresql://user:password@localhost:5432/meucontrato?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# Google Gemini
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-pro"

# Redis
REDIS_URL="redis://localhost:6379"

# Server
PORT=3001
NODE_ENV="development"
CORS_ORIGIN="http://localhost:3000"

# Stripe
STRIPE_SECRET_KEY="sk_test_your_stripe_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"
STRIPE_PRO_PRICE_ID="price_pro_monthly"
STRIPE_BUSINESS_PRICE_ID="price_business_monthly"

# ZapSign (optional)
ZAPSIGN_API_KEY="your_zapsign_key"
ZAPSIGN_API_URL="https://api.zapsign.com.br"
ZAPSIGN_WEBHOOK_SECRET="your_zapsign_webhook_secret"
ZAPSIGN_ALLOWED_IPS="192.168.1.1,192.168.1.2"

# ClickSign (optional)
CLICKSIGN_API_KEY="your_clicksign_key"
CLICKSIGN_API_URL="https://api.clicksign.com"
CLICKSIGN_WEBHOOK_SECRET="your_clicksign_webhook_secret"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# AWS S3 (para armazenamento de PDFs)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your_aws_access_key_id"
AWS_SECRET_ACCESS_KEY="your_aws_secret_access_key"
AWS_S3_BUCKET="meucontrato-pdfs"
# AWS_ENDPOINT="http://localhost:4566" # Opcional: para LocalStack/MinIO em desenvolvimento
