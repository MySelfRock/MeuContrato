# Database
DATABASE_URL="postgresql://user:password@localhost:5432/meucontrato?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# OpenAI
OPENAI_API_KEY="sk-your-openai-api-key"
OPENAI_MODEL="gpt-4-turbo-preview"

# Redis
REDIS_URL="redis://localhost:6379"

# Server
PORT=3001
NODE_ENV="development"
CORS_ORIGIN="http://localhost:3000"

# Stripe
STRIPE_SECRET_KEY="sk_test_your_stripe_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"

# ZapSign (optional)
ZAPSIGN_API_KEY="your_zapsign_key"
ZAPSIGN_API_URL="https://api.zapsign.com.br"

# ClickSign (optional)
CLICKSIGN_API_KEY="your_clicksign_key"
CLICKSIGN_API_URL="https://api.clicksign.com"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
